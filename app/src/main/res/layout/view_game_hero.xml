<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de progreso del estudiante: nivel, XP, racha y estadísticas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/game_hero_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hero_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_hero_level"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_level_badge"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:textColor="@color/game_on_hero"
            android:textSize="24sp"
            tools:text="3" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_hero_rank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/game_on_hero"
                android:textSize="18sp"
                tools:text="Nivel 3 · Aprendiz" />

            <TextView
                android:id="@+id/text_hero_xp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/game_on_hero_secondary"
                android:textSize="13sp"
                tools:text="150 / 200 XP" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_hero_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/game_on_hero"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="🔥 5 días" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_hero_xp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:max="100"
        app:indicatorColor="@color/game_xp"
        app:trackColor="@color/game_xp_track"
        app:trackCornerRadius="6dp"
        app:trackThickness="10dp"
        tools:progress="60" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_hero_tasks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/game_on_hero"
                android:textSize="20sp"
                tools:text="24" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_stat_tasks"
                android:textColor="@color/game_on_hero_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_hero_sessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/game_on_hero"
                android:textSize="20sp"
                tools:text="12" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_stat_focus"
                android:textColor="@color/game_on_hero_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_hero_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/game_on_hero"
                android:textSize="20sp"
                tools:text="5.5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_stat_hours"
                android:textColor="@color/game_on_hero_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/text_hero_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pill"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="@string/game_view_achievements"
        android:textColor="@color/game_on_hero"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
